+/// Drops every top-level message and enum that `keep.txt` (the types the client uses) cannot reach
+/// through a field, so the generated code holds only what a build actually needs. A field whose type
+/// was dropped never happens: everything a kept type mentions is kept with it.
+fn prune_unused(fds: &mut FileDescriptorSet) -> std::io::Result<()> {
+    use std::collections::{HashMap, HashSet};
+
+    // `.whatsapp.Foo.Bar.baz` names the top-level type `Foo`.
+    fn top_level(type_name: &str) -> Option<&str> {
+        type_name.strip_prefix(".whatsapp.")?.split('.').next()
+    }
+    fn mentions(message: &DescriptorProto, out: &mut Vec<String>) {
+        for field in &message.field {
+            if let Some(name) = field.type_name.as_deref().and_then(top_level) {
+                out.push(name.to_owned());
+            }
+        }
+        for nested in &message.nested_type {
+            mentions(nested, out);
+        }
+    }
+
+    // A message-typed field nobody reads by name is dropped (its wire bytes are skipped when decoding),
+    // which takes its whole sub-tree of message kinds with it once nothing else mentions them.
+    {
+        use heck::ToSnakeCase as _;
+        let used: HashSet<String> = std::fs::read_to_string("keep_fields.txt")?.lines().map(str::to_owned).collect();
+        fn drop_fields(message: &mut DescriptorProto, used: &HashSet<String>) {
+            message.field.retain(|field| {
+                let is_message = field.r#type == Some(field_descriptor_proto::Type::TYPE_MESSAGE);
+                !is_message || used.contains(&field.name.as_deref().unwrap_or_default().to_snake_case())
+            });
+            for nested in &mut message.nested_type {
+                drop_fields(nested, used);
+            }
+        }
+        for file in &mut fds.file {
+            for message in &mut file.message_type {
+                drop_fields(message, &used);
+            }
+        }
+    }
+
+    let keep = std::fs::read_to_string("keep.txt")?;
+    let mut pending: Vec<String> = keep.lines().map(str::trim).filter(|l| !l.is_empty()).map(str::to_owned).collect();
+    let mut edges: HashMap<String, Vec<String>> = HashMap::new();
+    for file in &fds.file {
+        for message in &file.message_type {
+            let mut out = Vec::new();
+            mentions(message, &mut out);
+            edges.insert(message.name.clone().unwrap_or_default(), out);
+        }
+    }
+    let mut reached: HashSet<String> = HashSet::new();
+    while let Some(name) = pending.pop() {
+        if reached.insert(name.clone()) {
+            pending.extend(edges.get(&name).cloned().unwrap_or_default());
+        }
+    }
+    for file in &mut fds.file {
+        file.message_type.retain(|m| reached.contains(m.name.as_deref().unwrap_or_default()));
+        file.enum_type.retain(|e| reached.contains(e.name.as_deref().unwrap_or_default()));
+    }
+    Ok(())
+}
